<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nwav.editorpdf.controller.NwavVisorController"
            styleClass="nwav-visor">

    <fx:define>
        <ToggleGroup fx:id="nwavGrupoAjuste"/>
    </fx:define>

    <!-- ============ BARRA DE HERRAMIENTAS ============ -->
    <top>
      <VBox>
        <HBox styleClass="nwav-barra-visor" spacing="6.0" alignment="CENTER_LEFT">
            <Button text="Abrir" onAction="#nwavOnAbrir" styleClass="accent">
                <graphic><FontIcon iconLiteral="fth-folder"/></graphic>
                <tooltip><Tooltip text="Abrir un PDF (Ctrl/⌘ + O)"/></tooltip>
            </Button>
            <Button fx:id="nwavBtnCerrar" onAction="#nwavOnCerrar" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                <tooltip><Tooltip text="Cerrar documento"/></tooltip>
            </Button>

            <Button fx:id="nwavBtnGuardarComo" onAction="#nwavOnGuardarComo" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-save"/></graphic>
                <tooltip><Tooltip text="Guardar como… (Ctrl/⌘ + Mayús + S)"/></tooltip>
            </Button>

            <Separator orientation="VERTICAL"/>
            <Button fx:id="nwavBtnDeshacer" onAction="#nwavOnDeshacer" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-corner-up-left"/></graphic>
            </Button>
            <Button fx:id="nwavBtnRehacer" onAction="#nwavOnRehacer" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-corner-up-right"/></graphic>
            </Button>
            <MenuButton fx:id="nwavMbtPaginas" text="Páginas" styleClass="flat">
                <graphic><FontIcon iconLiteral="fth-layers"/></graphic>
                <items>
                    <MenuItem text="Rotar a la izquierda" onAction="#nwavOnRotarIzquierda">
                        <graphic><FontIcon iconLiteral="fth-rotate-ccw"/></graphic>
                    </MenuItem>
                    <MenuItem text="Rotar a la derecha" onAction="#nwavOnRotarDerecha">
                        <graphic><FontIcon iconLiteral="fth-rotate-cw"/></graphic>
                    </MenuItem>
                    <MenuItem text="Girar 180°" onAction="#nwavOnGirar180">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Duplicar" onAction="#nwavOnDuplicar">
                        <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
                    </MenuItem>
                    <MenuItem text="Eliminar" onAction="#nwavOnEliminar">
                        <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Insertar páginas…" onAction="#nwavOnInsertar">
                        <graphic><FontIcon iconLiteral="fth-file-plus"/></graphic>
                    </MenuItem>
                    <MenuItem text="Extraer páginas…" onAction="#nwavOnExtraer">
                        <graphic><FontIcon iconLiteral="fth-external-link"/></graphic>
                    </MenuItem>
                    <MenuItem text="Dividir PDF…" onAction="#nwavOnDividir">
                        <graphic><FontIcon iconLiteral="fth-scissors"/></graphic>
                    </MenuItem>
                    <MenuItem text="Unir PDF…" onAction="#nwavOnUnir">
                        <graphic><FontIcon iconLiteral="fth-git-merge"/></graphic>
                    </MenuItem>
                </items>
            </MenuButton>

            <Separator orientation="VERTICAL"/>
            <ToggleButton fx:id="nwavTglMiniaturas" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-sidebar"/></graphic>
                <tooltip><Tooltip text="Mostrar u ocultar miniaturas"/></tooltip>
            </ToggleButton>

            <Separator orientation="VERTICAL"/>
            <Button fx:id="nwavBtnAnterior" onAction="#nwavOnPaginaAnterior" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-chevron-up"/></graphic>
                <tooltip><Tooltip text="Página anterior"/></tooltip>
            </Button>
            <TextField fx:id="nwavTxtPagina" styleClass="nwav-campo-pagina" prefColumnCount="3"/>
            <Label fx:id="nwavLblTotalPaginas" text="/ 0" styleClass="nwav-texto-tenue"/>
            <Button fx:id="nwavBtnSiguiente" onAction="#nwavOnPaginaSiguiente" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-chevron-down"/></graphic>
                <tooltip><Tooltip text="Página siguiente"/></tooltip>
            </Button>

            <Separator orientation="VERTICAL"/>
            <Button fx:id="nwavBtnAlejar" onAction="#nwavOnAlejar" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-zoom-out"/></graphic>
                <tooltip><Tooltip text="Alejar (Ctrl/⌘ + −)"/></tooltip>
            </Button>
            <ComboBox fx:id="nwavCmbZoom" editable="true" prefWidth="104.0" styleClass="nwav-combo-zoom"/>
            <Button fx:id="nwavBtnAcercar" onAction="#nwavOnAcercar" styleClass="button-icon, flat">
                <graphic><FontIcon iconLiteral="fth-zoom-in"/></graphic>
                <tooltip><Tooltip text="Acercar (Ctrl/⌘ + +)"/></tooltip>
            </Button>
            <ToggleButton fx:id="nwavTglAjustarAncho" text="Ancho" toggleGroup="$nwavGrupoAjuste"
                          styleClass="flat">
                <graphic><FontIcon iconLiteral="fth-maximize-2"/></graphic>
                <tooltip><Tooltip text="Ajustar al ancho"/></tooltip>
            </ToggleButton>
            <ToggleButton fx:id="nwavTglAjustarPagina" text="Página" toggleGroup="$nwavGrupoAjuste"
                          styleClass="flat">
                <graphic><FontIcon iconLiteral="fth-file"/></graphic>
                <tooltip><Tooltip text="Ajustar a la página"/></tooltip>
            </ToggleButton>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="nwavLblArchivo" styleClass="nwav-nombre-archivo" textOverrun="CENTER_ELLIPSIS" minWidth="0"/>
        </HBox>

        <!-- Herramientas de edicion de contenido (Fase 3); los botones se crean en el controlador -->
        <HBox fx:id="nwavBarraEdicion" styleClass="nwav-barra-edicion" spacing="6.0" alignment="CENTER_LEFT">
            <HBox fx:id="nwavBotonesHerramientas" spacing="2.0" alignment="CENTER_LEFT"/>
            <Separator orientation="VERTICAL"/>
            <ColorPicker fx:id="nwavSelectorColor" styleClass="nwav-selector-color">
                <tooltip><Tooltip text="Color"/></tooltip>
            </ColorPicker>
            <HBox fx:id="nwavControlesGrosor" spacing="6.0" alignment="CENTER_LEFT">
                <Label text="Grosor" styleClass="nwav-texto-tenue"/>
                <Spinner fx:id="nwavSpnGrosor" editable="true" prefWidth="84.0"/>
            </HBox>
            <HBox fx:id="nwavControlesTexto" spacing="6.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="nwavCmbFuente" prefWidth="190.0"/>
                <Spinner fx:id="nwavSpnTamano" editable="true" prefWidth="76.0">
                    <tooltip><Tooltip text="Tamaño en puntos"/></tooltip>
                </Spinner>
                <ToggleButton fx:id="nwavTglNegrita" styleClass="button-icon, flat">
                    <graphic><FontIcon iconLiteral="fth-bold"/></graphic>
                    <tooltip><Tooltip text="Negrita"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="nwavTglCursiva" styleClass="button-icon, flat">
                    <graphic><FontIcon iconLiteral="fth-italic"/></graphic>
                    <tooltip><Tooltip text="Cursiva"/></tooltip>
                </ToggleButton>
            </HBox>
            <Label fx:id="nwavLblAyudaHerramienta" styleClass="nwav-ayuda-herramienta" wrapText="true"
                   minWidth="0" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
      </VBox>
    </top>

    <!-- ============ MINIATURAS ============ -->
    <left>
        <VBox fx:id="nwavPanelMiniaturas" styleClass="nwav-panel-miniaturas" prefWidth="170.0" minWidth="170.0">
            <Label text="PÁGINAS" styleClass="nwav-panel-titulo"/>
            <Label text="Arrastra para reordenar · clic derecho para más opciones" styleClass="nwav-panel-ayuda"
                   wrapText="true"/>
            <ListView fx:id="nwavListaMiniaturas" VBox.vgrow="ALWAYS" styleClass="nwav-lista-miniaturas"/>
        </VBox>
    </left>

    <!-- ============ DOCUMENTO ============ -->
    <center>
        <StackPane styleClass="nwav-zona-documento">
            <ScrollPane fx:id="nwavScroll" styleClass="nwav-scroll-documento" pannable="false">
                <VBox fx:id="nwavContenedorPaginas" alignment="TOP_CENTER" fillWidth="false"/>
            </ScrollPane>

            <VBox fx:id="nwavPanelVacio" styleClass="nwav-vacio" alignment="CENTER" spacing="10.0"
                  maxWidth="440.0" maxHeight="-Infinity">
                <StackPane styleClass="nwav-vacio-circulo">
                    <FontIcon iconLiteral="fth-file-plus"/>
                </StackPane>
                <Label text="Abre un documento PDF" styleClass="nwav-vacio-titulo"/>
                <Label text="Arrastra un archivo a esta ventana, usa Archivo › Abrir o el botón de abajo. Los PDF protegidos te pedirán su contraseña."
                       styleClass="nwav-vacio-detalle" wrapText="true" textAlignment="CENTER"/>
                <HBox spacing="10.0" alignment="CENTER" styleClass="nwav-vacio-acciones">
                    <Button text="Abrir PDF…" onAction="#nwavOnAbrir" styleClass="accent, nwav-boton-principal">
                        <graphic><FontIcon iconLiteral="fth-folder"/></graphic>
                    </Button>
                    <Button text="Ver recientes" onAction="#nwavOnVerRecientes"
                            styleClass="button-outlined, nwav-boton-principal">
                        <graphic><FontIcon iconLiteral="fth-clock"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
