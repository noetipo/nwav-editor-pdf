<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nwav.editorpdf.controller.NwavInicioController"
            fitToWidth="true" styleClass="nwav-pagina-scroll">

    <VBox styleClass="nwav-pagina">
        <HBox styleClass="nwav-pagina-cabecera">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Herramientas PDF" styleClass="nwav-pagina-titulo"/>
                <Label text="Todo se procesa en tu equipo: tus archivos nunca salen de él."
                       styleClass="nwav-pagina-subtitulo"/>
            </VBox>
        </HBox>
        <HBox styleClass="nwav-barra-herramientas">
            <FontIcon iconLiteral="fth-search" styleClass="nwav-icono-tenue"/>
            <TextField fx:id="nwavTxtBuscar" promptText="Buscar herramienta (p. ej. comprimir, OCR, unir…)"
                       styleClass="nwav-buscador" HBox.hgrow="ALWAYS" maxWidth="520.0"/>
        </HBox>
        <Label fx:id="nwavLblSinResultados" text="Ninguna herramienta coincide con la búsqueda."
               styleClass="nwav-texto-tenue"/>
        <VBox fx:id="nwavContenedorCategorias" spacing="26.0"/>
    </VBox>
</ScrollPane>
